*//////////////////////////////////////////////////////////
* models for mixed digital simulation
*//////////////////////////////////////////////////////////

* TTL input
.model adc adc_bridge(in_low = 0.8 in_high = 2.7)

* TTL output
.model dac dac_bridge(out_low = 0.2 out_high = 4.6 out_undef = 2.2)

* Logic circuits
.model NOT_D d_inverter
.model AND_D d_and
.model NAND_D d_nand
.model OR_D d_or
.model NOR_D d_nor
.model XOR_D d_xor
.model XNOR_D d_xnor
.model DFLIP_D d_dff(ic=0)
.model CLOCK_D d_osc(cntl_array = [0 5] freq_array = [50k 150k] duty_cycle = 0.5)
.model PULLDOWN_D d_pulldown
.model PULLUP_D d_pullup

*//////////////////////////////////////////////////////////
* subcircuits for KiCad simulation of logic with "analog" voltages
*//////////////////////////////////////////////////////////

*//////////////////////////////////////////////////////////
* a->d converter for voltage-level analog inputs
*//////////////////////////////////////////////////////////
*
* connections:                input
*                             |   output
*                             |   | 
.SUBCKT SVC_LOGIC_ADC         1   2

a1 [1] [2] adc

.ends

*//////////////////////////////////////////////////////////
* d->a converter for voltage-level analog output/measurements
*//////////////////////////////////////////////////////////
*
* connections:                input
*                             |   output
*                             |   | 
.SUBCKT SVC_LOGIC_DAC         1   2

a1 [1] [2] dac

.ends


*//////////////////////////////////////////////////////////
* inverter
*//////////////////////////////////////////////////////////
* 8/27/2020  modified for svc.lib name and digital only
*
* connections:                input
*                             |   output
*                             |   | 
.SUBCKT SVC_LOGIC_NOT         1   2

a1 1 2 NOT_D

.ends


*//////////////////////////////////////////////////////////
* 2-input and
*//////////////////////////////////////////////////////////
* 8/27/2020 modified for svc.lib name and digital only
*
* connections:                 input A
*                              |   input B
*                              |   |   output
*                              |   |   |
.SUBCKT SVC_LOGIC_AND          1   2   3

a3 [1 2] 3 AND_D

.ends

*//////////////////////////////////////////////////////////
* 2-input nand
*//////////////////////////////////////////////////////////
* 8/27/2020 modified for svc.lib name and digital only
*
* connections:                input A
*                             |   input B
*                             |   |   output
*                             |   |   |
.SUBCKT SVC_LOGIC_NAND        1   2   3

a3 [1 2] 3 NAND_D

.ends

*//////////////////////////////////////////////////////////
* 2-input or
*//////////////////////////////////////////////////////////
* 8/27/2020 modified for svc.lib name and digital only
* 
* connections:                input A
*                             |   input B
*                             |   |   output
*                             |   |   |
.SUBCKT SVC_LOGIC_OR          1   2   3

a3 [1 2] 3 OR_D

.ends

*//////////////////////////////////////////////////////////
* 2-input nor
*//////////////////////////////////////////////////////////
* 8/27/2020 modified for svc.lib name and digital only
*
* connections:                input A
*                             |   input B
*                             |   |   output
*                             |   |   |
.SUBCKT SVC_LOGIC_NOR         1   2   3

a3 [1 2] 3 NOR_D

.ends

*//////////////////////////////////////////////////////////
* 2-input xor
*//////////////////////////////////////////////////////////
* 8/27/2020 modified for svc.lib name and digital only
*
* connections:                input A
*                             |   input B
*                             |   |   output
*                             |   |   |
.SUBCKT SVC_LOGIC_XOR         1   2   3

a3 [1 2] 3 XOR_D

.ends

*//////////////////////////////////////////////////////////
* 2-input xnor
*//////////////////////////////////////////////////////////
* 8/27/2020 modified for svc.lib name and digital only
*
* connections:                input A
*                             |   input B
*                             |   |   output
*                             |   |   |
.SUBCKT SVC_LOGIC_XNOR        1   2   3

a3 [1 2] 3 XNOR_D

.ends


*//////////////////////////////////////////////////////////
* D flip-flop 
*//////////////////////////////////////////////////////////
*
* connections:               D
*                            |   clock
*                            |   |   Q
*                            |   |   |   NQ
*                            |   |   |   |    Set
*                            |   |   |   |    |   Reset
*                            |   |   |   |    |   |
.SUBCKT SVC_LOGIC_DFLIPFLOP  1   2   3   4    5   6

a5 1 2 5 6 3 4 DFLIP_D


.ends


*//////////////////////////////////////////////////////////
* 100 kHz digital clock source, purely digital
*//////////////////////////////////////////////////////////
*
* connections:               clock out
*                            |   ground
*                            |   |  
.SUBCKT SVC_LOGIC_CLOCK      1   2

v1 3 2 DC 2.5
a1 3 1 clock_d

.ends


*//////////////////////////////////////////////////////////
* digital pull-down (digital 0)
*//////////////////////////////////////////////////////////

.SUBCKT SVC_LOGIC_ZERO 1

a1 1 pulldown_d

.ends

*//////////////////////////////////////////////////////////
* digital pull-up (digital 1)
*//////////////////////////////////////////////////////////

.SUBCKT SVC_LOGIC_ONE 1

a1 1 pullup_d

.ends